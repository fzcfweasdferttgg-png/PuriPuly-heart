  "debug_preview.local_qwen_hallucination_modal": "Avviso Qwen locale",
  "local_qwen_hallucination.body": "Il modello locale di riconoscimento vocale non funziona correttamente ora.\nPassa a un servizio cloud.\n\nRaccomandiamo Deepgram. Puoi usarlo gratis.\nApri la guida GitHub e segui le istruzioni.",
  "local_qwen_hallucination.open_guide": "Apri guida",
  "local_qwen_hallucination.close": "Chiudi",
  "peer_translation_eula.body": "PuriPuly cattura l'audio desktop tramite loopback per tradurre la voce dell'altro.\nQuesto significa che può elaborare l'audio di qualcuno senza consenso.\nA seconda della tua regione, questo potrebbe violare le leggi locali.\n\nSei legalmente responsabile dell'uso di questo strumento.\nUsalo solo nelle conversazioni a cui partecipi attivamente.\n\nPuriPuly non memorizza l'audio, le trascrizioni o i risultati della traduzione dell'altro.\nTuttavia, i provider esterni configurati possono elaborare i dati.",
  "peer_translation_eula.accept": "Capisco",
  "peer_translation_eula.cancel": "Annulla",
  "peer_translation_eula.show_again": "Mostra di nuovo",
  "peer_translation_eula.show_again.description": "Mostra questo messaggio di nuovo",
  "openrouter.handoff.title": "Dal creatore",
